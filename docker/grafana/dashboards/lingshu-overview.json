        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(lingshu_chat_requests_total, tenant)",
        "includeAll": true,
        "label": "Tenant",
        "multi": true,
        "name": "tenant",
        "query": {"query": "label_values(lingshu_chat_requests_total, tenant)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
