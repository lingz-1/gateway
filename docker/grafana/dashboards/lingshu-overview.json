{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (status) (rate(lingshu_chat_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Chat request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(lingshu_chat_duration_seconds_sum[5m])) / clamp_min(sum(rate(lingshu_chat_duration_seconds_count[5m])), 1) * 1000", "legendFormat": "average", "refId": "A"}],
      "title": "Average chat latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (type) (rate(lingshu_chat_tokens_total[5m]))", "legendFormat": "{{type}}", "refId": "A"}],
      "title": "Token rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "currencyCNY"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum(lingshu_chat_virtual_cost_cny_total)", "legendFormat": "virtual cost", "refId": "A"}],
      "title": "Accumulated virtual cost",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "sum(rate(lingshu_chat_requests_total{cache=~\"exact|semantic\"}[5m])) / clamp_min(sum(rate(lingshu_chat_requests_total[5m])), 0.000001)", "legendFormat": "cache hit ratio", "refId": "A"}],
      "title": "Cache hit ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
