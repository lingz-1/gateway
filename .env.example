LINGSHU_DATA_ROOT=E:/LingShuData
LINGSHU_POSTGRES_PASSWORD=replace-with-a-strong-local-password
LINGSHU_REDIS_PASSWORD=replace-with-a-strong-local-password
LINGSHU_GRAFANA_ADMIN_USER=admin
LINGSHU_GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password

# Optional settlement event relay (disabled by default)
# LINGSHU_KAFKA_ENABLED=false
# LINGSHU_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# LINGSHU_BILLING_ENABLED=false
# LINGSHU_VIRTUAL_BILLING_PERSISTENCE_ENABLED=false
# LINGSHU_DATABASE_MIGRATION_ENABLED=false
# LINGSHU_TENANT_POLICY_PERSISTENCE_ENABLED=false
# LINGSHU_BILLING_OUTBOX_ENABLED=false
# LINGSHU_BILLING_KAFKA_TOPIC=lingshu.billing.events

# Optional Nacos tenant-policy source (disabled by default)
# LINGSHU_TENANT_POLICY_NACOS_ENABLED=false
# LINGSHU_NACOS_SERVER_URL=http://127.0.0.1:8848
# LINGSHU_NACOS_NAMESPACE_ID=public
# LINGSHU_NACOS_GROUP_NAME=LINGSHU
# LINGSHU_NACOS_DATA_ID=lingshu-tenant-policies.json
# LINGSHU_NACOS_ACCESS_TOKEN=replace-with-nacos-access-token
# LINGSHU_NACOS_TIMEOUT=2s
# LINGSHU_NACOS_REFRESH_DELAY_MS=5000

# Optional protection for Core /internal/** endpoints
# LINGSHU_INTERNAL_ADMIN_KEY=replace-with-a-local-admin-key

# DeepSeek OpenAI-compatible chat provider
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# LINGSHU_DEEPSEEK_MODEL=deepseek-v4flash

# Optional OpenAI-compatible embedding provider configuration
# LINGSHU_EMBEDDING_PROVIDER=openai-compatible
# LINGSHU_EMBEDDING_ENDPOINT=https://provider.example/v1/embeddings
# LINGSHU_EMBEDDING_MODEL=replace-with-embedding-model
# LINGSHU_EMBEDDING_DIMENSION=1024
# LINGSHU_EMBEDDING_API_KEY=replace-with-provider-key

# Local TEI embedding service (Qwen3-Embedding-4B)
# LINGSHU_EMBEDDING_PROVIDER=tei
# LINGSHU_EMBEDDING_ENDPOINT=http://127.0.0.1:8090/embed
# LINGSHU_EMBEDDING_MODEL=Qwen3-Embedding-4B
# LINGSHU_EMBEDDING_DIMENSION=2560
